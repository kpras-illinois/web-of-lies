if (room = asset_get_index("Main_Room")) {
	with (asset_get_index("Dialogue_Helper")) {
		create_dialogue_box([
		    [ "Wilber E. Bose", "So... what's with the blood?" ],

[ "Wayne Mothman", "I got into a little conflict on my way here." ],

[ "Wilber E. Bose", "A conflict?" ],

[ "Wayne Mothman", "A robber tried to take my money. I handled it." ],

[ "Wilber E. Bose", "You handled it?" ],

[ "Wayne Mothman", "He ran. I walked away. That's all there is to it." ],

[ "Wilber E. Bose", "Right. You wouldn't happen to have a weapon on you, would you?" ],

[ "Wayne Mothman", "I prefer not to answer that." ],

[ "Wilber E. Bose", "That's an interesting answer." ],

[ "Wayne Mothman", "It's a private matter." ],

[ "Wilber E. Bose", "Fine. We'll come back to it. Where were you before the fight?" ],

[ "Wayne Mothman", "Chasse Bank." ],

[ "Wilber E. Bose", "What were you doing there?" ],

[ "Wayne Mothman", "Working. I'm an accountant." ],

[ "Wilber E. Bose", "I've never seen you there." ],

[ "Wayne Mothman", "You wouldn't have. I've only been there a month." ],

[ "Wilber E. Bose", "A month?" ],

[ "Wayne Mothman", "Yes." ],

[ "Wilber E. Bose", "Well, nice job you got there. You'll be a millionaire someday." ],

[ "Wayne Mothman", "...Yeah."],

[ "Wilber E. Bose", "You don't seem very excited." ],

[ "Wayne Mothman", "It's just a job." ],

[ "Wilber E. Bose", "Fair enough. Let's talk about B Tell." ],

[ "Wilber E. Bose", "How long did you know him?" ],

[ "Wayne Mothman", "Since high school. But we weren't particularly close." ],

[ "Wilber E. Bose", "Really? You went to the same school and you knew each other for years." ],

[ "Wayne Mothman", "People grow apart." ],

[ "Wilber E. Bose", "Did you two ever do anything together?" ],

[ "Wayne Mothman", "We had a little club." ],

[ "Wilber E. Bose", "What kind of club?" ],

[ "Wayne Mothman", "Business, mostly. We liked talking about money." ],

[ "Wilber E. Bose", "Business?" ],

[ "Wayne Mothman", "Yes." ],

[ "Wilber E. Bose", "That's a strange word for a school club." ],

[ "Wayne Mothman", "We were ambitious kids." ],

[ "Wilber E. Bose", "What did you call it?" ],

[ "Wayne Mothman", "Moth and Tell." ],

[ "Wilber E. Bose", "You seem to remember it pretty well for something that long ago." ],

[ "Wayne Mothman", "I remember a lot of things." ],

[ "Wilber E. Bose", "Apparently." ],

[ "Wilber E. Bose", "So you were interested in business even back then." ],

[ "Wayne Mothman", "Of course." ],

[ "Wilber E. Bose", "And now you're an accountant at a bank." ],

[ "Wayne Mothman", "Yes." ],

[ "Wilber E. Bose", "Funny. You don't really look like an accountant." ],

[ "Wilber E. Bose", "You said you were an accountant for a month. Yet you seem awfully comfortable talking about protecting yourself, carrying weapons, and handling robbers." ],

[ "Wayne Mothman", "I've lived a difficult life." ],

[ "Wilber E. Bose", "What kind of difficult life?" ],

[ "Wayne Mothman", "The kind where you learn not to trust people." ],

[ "Wilber E. Bose", "That’s not really an answer." ],

[ "Wilber E. Bose", "What do you do?" ],

[ "Wayne Mothman", "I lend money"],

[ "Wilber E. Bose", "A loanshark." ],

[ "Wayne Mothman", "If you want to call it that." ],

[ "Wilber E. Bose", "What would you call it?" ],

[ "Wayne Mothman", "Business." ],

[ "Wilber E. Bose", "And B Tell knew?" ],

[ "Wayne Mothman", "...Yes." ],

[ "Wilber E. Bose", "That's why you two stopped working together." ],

[ "Wayne Mothman", "He didn't approve." ],

[ "Wilber E. Bose", "Because you were making money illegally." ],

[ "Wayne Mothman", "Because he was afraid of making real money." ],

[ "Wayne Mothman", "Because we had something once." ],

[ "Wilber E. Bose", "Something worth keeping?" ],

[ "Wayne Mothman", "Something worth remembering." ],

[ "Wilber E. Bose", "Then tell me what happened." ],

[ "Wayne Mothman", "We wanted to make it big. We had nothing. No money, no connections, nothing. Just a stupid little idea and a desk in his garage." ],

[ "Wilber E. Bose", "And then?" ],

[ "Wayne Mothman", "I found another way." ],

[ "Wilber E. Bose", "Illegal money." ],

[ "Wayne Mothman", "You don't understand." ],

[ "Wilber E. Bose", "Then explain it to me." ],

[ "Wayne Mothman", "You think people like me get handed opportunities? You think the world cares whether or not you play fair? All that matters is money." ],

[ "Wayne Mothman", "You could inherit a fortune and still have no idea how the world actually works. Money is all that matters." ],

[ "Wilber E. Bose", "We're talking about B Tell." ],

[ "Wayne Mothman", "I know who we're talking about!" ],

[ "Wilber E. Bose", "Then tell me why he had to die." ],

[ "Wayne Mothman", "I never said he had to." ],

[ "Wilber E. Bose", "But you wanted him dead." ],

[ "Wayne Mothman", "...I just wanted him to shut up and stop yapping"],

[ "Wilber E. Bose", "Why?" ],

[ "Wayne Mothman", "Because he wouldn't let it go." ],

[ "Wilber E. Bose", "He was going to expose you." ],

[ "Wayne Mothman", "You don't know what I'd lose." ],

[ "Wilber E. Bose", "Then why shouldn't I think you killed him?" ],

[ "Wayne Mothman", "...Because I didn't." ],

[ "Wilber E. Bose", "You wanted him dead." ],

[ "Wayne Mothman", "Wanting someone dead and killing them aren't the same thing." ],

[ "Wilber E. Bose", "Then what happened between you two?" ],

[ "Wayne Mothman", "He started calling me Dorian." ],

[ "Wilber E. Bose", "Dorian?" ],

[ "Wayne Mothman", "After I showed him how people actually become millionaires." ],

[ "Wilber E. Bose", "And he hated you for it?" ],

[ "Wayne Mothman", "He thought I had become someone else." ],

[ "Wilber E. Bose", "Were you?" ],

[ "Wayne Mothman", "...Maybe." ],

[ "Wilber E. Bose", "What did he say to you?" ],

[ "Wayne Mothman", "He said I wasn't the person we wanted to become." ],

[ "Wilber E. Bose", "And that bothered you?" ],

[ "Wayne Mothman", "It wasn't what he said." ],

[ "Wilber E. Bose", "Then what was it?" ],

[ "Wayne Mothman", "Every time I looked at him, I remembered who I was supposed to be." ],

[ "Wilber E. Bose", "And you couldn't live with that?" ],

[ "Wayne Mothman", "I spent years building everything I have." ],

[ "Wayne Mothman", "There were times I told myself I'd become a normal banker. And I did. I work at Chasse now." ],

[ "Wayne Mothman", "Only... he can't see it." ],

[ "Wilber E. Bose", "But you built it on crime." ],

[ "Wayne Mothman", "I built it." ],

[ "Wilber E. Bose", "And B Tell wanted to tear it down." ],

[ "Wayne Mothman", "He wanted me to go back." ],

[ "Wilber E. Bose", "Back to what?" ],

[ "Wayne Mothman", "Back to being nobody. Back to sitting in his garage listening to his stupid economic lectures while I could have been a millionaire." ],

[ "Wilber E. Bose", "So you chose money over him." ],

[ "Wayne Mothman", "..." ],

[ "Wilber E. Bose", "Didn't you?" ]
		]);
	}
}
